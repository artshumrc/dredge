{
  "name": "dredge-runtime",
  "private": true,
  "type": "module",
  "description": "Dredge runtime worker + Milestone 4 browser validation harness",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && node scripts/build-prod.mjs",
    "fixture": "node scripts/build-fixture.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "vendor": "tsc --noEmit && node scripts/vendor-assets.mjs",
    "stage": "node scripts/stage-db.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.50.1-build1",
    "brotli-dec-wasm": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
